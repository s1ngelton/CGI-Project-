#version 430 core
// CP1 — BVH traversal validation. One primary ray per pixel, no shading:
// outputs hit normal (n0/n1/n2 barycentric-interpolated) as RGB8, matching
// RayTracer::renderNormals()'s encoding exactly so the two are diffable.

layout(local_size_x = 8, local_size_y = 8) in;

// Mirrors nanort::BVHNode<float> byte-for-byte (see RayTracer::exportForGPU doc).
struct BVHNode {
    float bminX, bminY, bminZ;
    float bmaxX, bmaxY, bmaxZ;
    int   flag;   // 0 = branch, 1 = leaf
    int   axis;
    uint  data0;  // branch: child0 idx   | leaf: primitive count
    uint  data1;  // branch: child1 idx   | leaf: offset into IndicesBuf
};

layout(std430, binding = 0) readonly buffer NodesBuf   { BVHNode nodes[]; };
layout(std430, binding = 1) readonly buffer IndicesBuf { uint    indices[]; };
layout(std430, binding = 2) readonly buffer VertsBuf   { float   verts[]; };   // 9 floats/tri
layout(std430, binding = 3) readonly buffer NormalsBuf { float   norms[]; };   // 9 floats/tri

layout(binding = 4, rgba8) uniform writeonly image2D outImg;

uniform vec3  uCamPos;
uniform vec3  uCamFront;
uniform vec3  uCamRight;
uniform vec3  uCamUp;
uniform float uAspect;
uniform float uTanHalfFov;
uniform int   uWidth;
uniform int   uHeight;

#define MAX_STACK 160  // BVH depth is 126 (reported at buildScene) — must exceed that, 64 silently truncated traversal
#define RAY_MIN_T 0.001
#define RAY_MAX_T 1.0e30

vec3 triVert(uint triIdx, uint which) {
    uint base = triIdx * 9u + which * 3u;
    return vec3(verts[base + 0u], verts[base + 1u], verts[base + 2u]);
}

vec3 triNorm(uint triIdx, uint which) {
    uint base = triIdx * 9u + which * 3u;
    return vec3(norms[base + 0u], norms[base + 1u], norms[base + 2u]);
}

// Möller–Trumbore, no back-face culling (matches nanort's cull_back_face=false).
bool intersectTri(vec3 ro, vec3 rd, uint triIdx, float tMax,
                  out float outT, out float outU, out float outV) {
    vec3 p0 = triVert(triIdx, 0u);
    vec3 p1 = triVert(triIdx, 1u);
    vec3 p2 = triVert(triIdx, 2u);

    vec3 e1 = p1 - p0;
    vec3 e2 = p2 - p0;
    vec3 pvec = cross(rd, e2);
    float det = dot(e1, pvec);
    if (abs(det) < 1e-9) return false;
    float invDet = 1.0 / det;

    vec3 tvec = ro - p0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(rd, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;

    float t = dot(e2, qvec) * invDet;
    if (t < RAY_MIN_T || t > tMax) return false;

    outT = t; outU = u; outV = v;
    return true;
}

// Returns true on hit; fills bestPrim/bestU/bestV (nanort convention:
// interp = (1-u-v)*p0 + u*p1 + v*p2).
bool traverseBVH(vec3 ro, vec3 rd, out uint bestPrim, out float bestU, out float bestV) {
    vec3 invDir = 1.0 / rd;
    ivec3 dirSign = ivec3(rd.x < 0.0 ? 1 : 0, rd.y < 0.0 ? 1 : 0, rd.z < 0.0 ? 1 : 0);

    int stack[MAX_STACK];
    int sp = 0;
    stack[sp++] = 0; // root

    float bestT = RAY_MAX_T;
    bestPrim = 0xFFFFFFFFu;
    bestU = 0.0; bestV = 0.0;

    while (sp > 0) {
        int nodeIdx = stack[--sp];
        BVHNode node = nodes[nodeIdx];

        vec3 bmin = vec3(node.bminX, node.bminY, node.bminZ);
        vec3 bmax = vec3(node.bmaxX, node.bmaxY, node.bmaxZ);

        vec3 t0 = (bmin - ro) * invDir;
        vec3 t1 = (bmax - ro) * invDir;
        vec3 tsmall = min(t0, t1);
        vec3 tbig   = max(t0, t1);
        float tmin = max(max(tsmall.x, tsmall.y), max(tsmall.z, RAY_MIN_T));
        float tmax = min(min(tbig.x, tbig.y), min(tbig.z, bestT));

        if (tmin > tmax) continue;

        if (node.flag == 0) {
            // Branch: push far child then near child (near pops first — matches
            // nanort::BVHAccel::Traverse's order_near/order_far scheme).
            int orderNear = (node.axis == 0) ? dirSign.x : (node.axis == 1 ? dirSign.y : dirSign.z);
            uint nearIdx = (orderNear == 0) ? node.data0 : node.data1;
            uint farIdx  = (orderNear == 0) ? node.data1 : node.data0;
            if (sp < MAX_STACK - 1) {
                stack[sp++] = int(farIdx);
                stack[sp++] = int(nearIdx);
            }
        } else {
            // Leaf: data0 = primitive count, data1 = offset into IndicesBuf.
            uint count  = node.data0;
            uint offset = node.data1;
            for (uint i = 0u; i < count; ++i) {
                uint primIdx = indices[offset + i];
                float t, u, v;
                if (intersectTri(ro, rd, primIdx, bestT, t, u, v)) {
                    bestT = t;
                    bestPrim = primIdx;
                    bestU = u; bestV = v;
                }
            }
        }
    }

    return bestPrim != 0xFFFFFFFFu;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= uWidth || px.y >= uHeight) return;

    float ndcX = (2.0 * (float(px.x) + 0.5) / float(uWidth)  - 1.0) * uAspect * uTanHalfFov;
    float ndcY = (1.0 - 2.0 * (float(px.y) + 0.5) / float(uHeight)) * uTanHalfFov;
    vec3 rd = normalize(uCamFront + ndcX * uCamRight + ndcY * uCamUp);

    uint prim; float u, v;
    vec3 color;
    if (traverseBVH(uCamPos, rd, prim, u, v)) {
        float w0 = 1.0 - u - v;
        vec3 n0 = triNorm(prim, 0u);
        vec3 n1 = triNorm(prim, 1u);
        vec3 n2 = triNorm(prim, 2u);
        vec3 N = normalize(w0 * n0 + u * n1 + v * n2);
        color = N * 0.5 + 0.5;
    } else {
        color = vec3(5.0 / 255.0, 6.0 / 255.0, 10.0 / 255.0);
    }

    imageStore(outImg, px, vec4(color, 1.0));
}
